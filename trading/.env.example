# Solana RPC Configuration
# Use public RPC (slower, rate limited)
RPC_URL=https://api.mainnet-beta.solana.com
# Or use premium RPC for better performance (recommended)
# RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_API_KEY
# RPC_URL=https://solana-mainnet.rpc.extrnode.com

# Trading Parameters
POSITION_SIZE=10          # USDC per trade
MAX_SLIPPAGE=1           # Maximum slippage percentage
MIN_LIQUIDITY=100000     # Minimum pool liquidity in USD
STOP_LOSS=10             # Stop loss percentage

# Entry Criteria
MIN_VOLUME_24H=50000     # Minimum 24h volume in USD
MIN_PRICE_CHANGE=5       # Minimum price change percentage
MIN_MARKET_CAP=100000    # Minimum market cap in USD

# Position Management
MAX_POSITIONS=3          # Maximum concurrent positions
POSITION_TIMEOUT=14400   # Position timeout in seconds (4 hours)

# Scanning Settings
SCAN_INTERVAL=30000      # Scan every 30 seconds
API_TIMEOUT=10000        # API request timeout in milliseconds

# Safety Features
DRY_RUN=false           # Set to true for paper trading
BLACKLIST=MEME,SCAM,INU,DOGE,FLOKI,SHIB,PEPE  # Comma-separated keywords to avoid
MAX_DAILY_LOSS=100      # Stop trading if daily loss exceeds this amount
EMERGENCY_STOP_LOSS=25  # Emergency stop if portfolio down this percentage

# Notifications (optional)
TELEGRAM_BOT_TOKEN=     # Your Telegram bot token
TELEGRAM_CHAT_ID=       # Your Telegram chat ID
DISCORD_WEBHOOK=        # Discord webhook URL

# Advanced Settings
ENABLE_PROFIT_TAKING=true     # Enable profit taking at +50%
ENABLE_TRAILING_STOP=false    # Enable trailing stop losses
MIN_PROFIT_FOR_TRAIL=20       # Minimum profit % to activate trailing stop
TRAIL_AMOUNT=5                # Trail by this percentage

# Performance Optimization
CACHE_TOKEN_DATA=true         # Cache token metadata
BATCH_API_REQUESTS=true       # Batch multiple API requests
MAX_CONCURRENT_REQUESTS=5     # Maximum concurrent API requests